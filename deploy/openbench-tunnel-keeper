#!/bin/bash
# URL-keeper for the ephemeral trycloudflare quick tunnel, kept as a fallback
# next to the named tunnel (cloudflared-openbench.service, bench.luminexchess.com).
# Runs as the tunnel service: starts cloudflared, watches for the assigned
# URL, and on every change rewrites the server's CSRF origins (the permanent
# hostname first, then the quick URL) and restarts OpenBench.
# The current quick URL is always readable at /home/ubuntu/current_bench_url.
set -u
URL_FILE=/home/ubuntu/current_bench_url
LOG=/var/log/openbench-tunnel.log
PERMANENT=https://bench.luminexchess.com
LAST=""
# Only this run's log lines count: older lines hold the previous run's URL.
START=$(stat -c %s "$LOG" 2>/dev/null || echo 0)

cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8000 >>"$LOG" 2>&1 &
CFPID=$!
trap 'kill '"$CFPID"' 2>/dev/null; exit 0' TERM INT

while kill -0 "$CFPID" 2>/dev/null; do
  sleep 10
  SIZE=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
  [ "$SIZE" -lt "$START" ] && START=0   # log truncated or rotated
  # Quick-tunnel hostnames are hyphenated words; this skips api.trycloudflare.com,
  # which appears in cloudflared's error lines.
  URL=$(tail -c +$((START + 1)) "$LOG" | grep -oE 'https://[a-z0-9]+(-[a-z0-9]+)+\.trycloudflare\.com' | tail -1)
  if [ -n "$URL" ] && [ "$URL" != "$LAST" ]; then
    echo "$(date -u +%FT%TZ) new tunnel URL: $URL" >>"$LOG"
    echo "$URL" > "$URL_FILE"
    chmod 644 "$URL_FILE"
    sed -i "s|^OPENBENCH_CSRF_ORIGINS=.*|OPENBENCH_CSRF_ORIGINS=$PERMANENT,$URL|" /opt/openbench/.env
    systemctl restart openbench
    LAST="$URL"
  fi
done
